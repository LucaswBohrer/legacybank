# LEGACYBANK — exemplo de variáveis de ambiente (NUNCA commitar valores reais)
# Copie para .env e preencha localmente se precisar.

# Token de acesso à API. Quando definido e não-vazio, todos os endpoints
# /api/v1/* exigem "Authorization: Bearer <token>" (exceto /health).
# Local: deixe vazio para acesso livre. Produção/demo: defina um valor.
LBAPI_TOKEN=

# Modo demo: 1 = exibe selo "DEMO ENVIRONMENT · Storage: EPHEMERAL" na UI
# e em /api/v1/health. Deploy gratuito (Render) usa 1.
LBAPI_DEMO_MODE=

# Porta / host / diretórios (padrões sensatos para dev local)
LBAPI_PORT=8123
LBAPI_HOST=127.0.0.1
LBAPI_DATA_DIR=./data
# PORT tem precedência sobre LBAPI_PORT (plataformas como Render injetam PORT)
